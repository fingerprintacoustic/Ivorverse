rules_version = '2';

// All reads/writes go through the Cloud Function (Firebase Admin SDK), which
// bypasses these rules entirely. This denies any direct client-side access
// to Firestore, since the app is not designed to talk to Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
