# Non-secret settings for the ivorverse-ai Firebase project, uploaded with the
# functions on deploy. Secrets (API keys, JWT_SECRET, STRIPE_WEBHOOK_SECRET)
# live in Secret Manager instead: firebase functions:secrets:set NAME
#
# The storage bucket comes from the FIREBASE_CONFIG the runtime provides
# (FIREBASE_* names are reserved here).

APP_URL=https://ivorverse-ai.web.app
PLATFORM_FEE_PERCENT=0
