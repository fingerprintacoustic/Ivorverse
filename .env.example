# --- Firebase / Firestore ---
# Not needed locally if you run `gcloud auth application-default login`
# or use the Firestore emulator (`npm run emulators`).
# For CI or environments without ADC, paste a service account JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Auth / sessions ---
JWT_SECRET=replace-with-a-long-random-string

# --- AI providers (the actual generation backends, called invisibly by IvorVerse) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# App Builder: real code-execution sandbox (same infrastructure Manus itself
# uses under the hood) — writes generated files, installs deps, runs the app,
# and returns a live preview URL. Get a key at https://e2b.dev
E2B_API_KEY=

# Music generation: real song audio via ACE-Step (open-weight, Apache 2.0),
# served by fal.ai. Get a key at https://fal.ai — this is the same open
# model that could later be self-hosted directly if you want off fal.ai too.
FAL_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- OAuth: REMOVED. Manus OAuth login was redundant with email/password
# auth (which is now the only login method) and has been fully removed,
# including the session-verification bug that came with it — see
# server/_core/session.ts for details.

# --- Still-remaining Manus dependency (a separate decision from OAuth) ---
# Web search/news/stock (via dataApi.ts + webSearch.ts), Google Maps
# (map.ts), and push notifications (notification.ts) still call Manus's
# Forge API proxy. Not touched yet — replacing these means wiring real
# Google Search/Maps APIs and a push provider directly.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Firebase Storage (generated images, uploaded files) ---
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

NODE_ENV=development
PORT=3000
