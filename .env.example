# --- Firebase / Firestore ---
# Not needed locally if you run `gcloud auth application-default login`
# or use the Firestore emulator (`npm run emulators`).
# For CI or environments without ADC, paste a service account JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Auth / sessions ---
JWT_SECRET=replace-with-a-long-random-string

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- OAuth (only needed if keeping Manus/OAuth login alongside email/password) ---
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# --- Manus Forge API (only relevant if still using Manus-hosted AI features) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

NODE_ENV=development
PORT=3000
